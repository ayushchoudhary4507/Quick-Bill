# PostgreSQL connection (SQLAlchemy URL format)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quickbill

# Comma-separated origins for browser clients (Vite default: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API prefix (no trailing slash)
API_V1_PREFIX=/api/v1

# Dev-only schema management.
# When true, the app will drop and recreate tables at startup.
# Use for local development only; use migrations for production.
RECREATE_TABLES_ON_STARTUP=false
